{
  "name": "ottertap-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1 --port 4186 --strictPort",
    "site:dev": "pnpm --filter ottertap-site dev",
    "site:build": "pnpm --filter ottertap-site typecheck && pnpm --filter ottertap-site build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/register-i18n.ts --test tests/*.test.ts",
    "verify-build": "node scripts/verify-build.mjs",
    "release": "node scripts/release.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@wxt-dev/i18n": "^0.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  }
}
